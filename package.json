{
  "name": "maestrinho",
  "productName": "Maestrinho",
  "version": "0.2.6-beta",
  "description": "Canvas infinito, 100% local e open source, para orquestrar agentes de IA de código (Claude Code, Codex, OpenCode, shells) que conversam entre si.",
  "license": "MIT",
  "author": "Os autores do Maestrinho",
  "homepage": "https://github.com/D0mileitor/maestrinho#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/D0mileitor/maestrinho.git"
  },
  "bugs": {
    "url": "https://github.com/D0mileitor/maestrinho/issues"
  },
  "private": true,
  "main": "./out/main/index.js",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "node scripts/launch.mjs dev",
    "build": "electron-vite build",
    "start": "node scripts/launch.mjs preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run lint && npm run test",
    "licenses": "node scripts/licenses.mjs",
    "pack": "electron-vite build && node scripts/pack.mjs",
    "instalador": "node scripts/instalador.mjs"
  },
  "dependencies": {
    "node-pty": "1.1.0"
  },
  "devDependencies": {
    "@electron/packager": "20.3.0",
    "@eslint/js": "10.0.1",
    "@fontsource/ibm-plex-sans": "5.3.0",
    "@fontsource/ibm-plex-sans-condensed": "5.3.0",
    "@types/node": "24.19.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-search": "0.16.0",
    "@xterm/addon-serialize": "0.14.0",
    "@xterm/addon-unicode11": "0.9.0",
    "@xterm/addon-web-links": "0.12.0",
    "@xterm/headless": "6.0.0",
    "@xterm/xterm": "6.0.0",
    "@xyflow/react": "12.12.0",
    "chokidar": "5.0.0",
    "electron": "44.5.1",
    "electron-vite": "5.0.0",
    "eslint": "10.11.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.12.0",
    "playwright-core": "1.63.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.0",
    "vite": "7.3.6",
    "vitest": "5.0.3",
    "zod": "4.6.5",
    "zustand": "5.0.15"
  }
}
